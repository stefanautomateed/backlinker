# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Website Details for Submission
WEBSITE_URL=https://automateed.com
WEBSITE_NAME=Automateed
WEBSITE_DESCRIPTION=AI-powered e-book generator that transforms your ideas into professionally formatted e-books
WEBSITE_EMAIL=stefan@automateed.com
WEBSITE_CATEGORY=AI Tools, SaaS, Content Creation
WEBSITE_TAGS=AI, ebook, generator, automation, content, writing

# Contact Information (can be randomized)
CONTACT_NAME=Stefan
CONTACT_COMPANY=Automateed

# Automation Settings
MAX_CONCURRENT_SUBMISSIONS=3
HEADLESS_BROWSER=true
SCREENSHOT_ON_ERROR=true
RETRY_ATTEMPTS=2
TIMEOUT_MS=30000

# Rate Limiting
DELAY_BETWEEN_SUBMISSIONS_MS=5000
DELAY_BETWEEN_PAGES_MS=2000

# CAPTCHA Solving (2captcha.com)
CAPTCHA_ENABLED=true
CAPTCHA_API_KEY=your_2captcha_api_key_here
CAPTCHA_SOLVER=2captcha
# Cost: ~$0.002 per CAPTCHA solved

# Bulk Parallel Submission Settings
BULK_SUBMISSION_ENABLED=true
PARALLEL_BROWSERS=5
BATCH_SIZE=20
PAUSE_BETWEEN_BATCHES_MS=60000

# Web Dashboard Settings
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3001
DASHBOARD_HOST=localhost
# Set username and password for dashboard access
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme123

# Guest Post Automation Settings
GUEST_POST_ENABLED=true
# Search API: 'serpapi' (recommended) or 'google'
GUEST_POST_SEARCH_ENGINE=serpapi
# Get SerpAPI key from https://serpapi.com (100 free searches/month, then $50 for 5000)
GUEST_POST_SEARCH_API_KEY=your_serpapi_key_here
# For Google Custom Search: get from https://developers.google.com/custom-search
# GUEST_POST_GOOGLE_SEARCH_ENGINE_ID=your_google_cse_id_here
# Content generation model
GUEST_POST_CONTENT_MODEL=gpt-4-turbo-preview
# Default niche for guest post search
GUEST_POST_NICHE=AI tools, SaaS, content creation
# Default word count for articles
GUEST_POST_WORD_COUNT=1500
